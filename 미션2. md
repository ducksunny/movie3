  function createCard(movie) {
    const card = document.createElement('div');
    card.className = 'card';
    card.draggable = true;
    card.id = 'movie-' + movie.id;
    card.innerHTML = `
      <div class="emoji">${movie.emoji}</div>
      <div class="title">${movie.title}</div>
    `;
    card.ondragstart = (e) => e.dataTransfer.setData('text', card.id);
    return card;
  }

  function allowDrop(e) {
    e.preventDefault();
  }

  function drop(e) {
    e.preventDefault();
    const id = e.dataTransfer.getData('text');
    const card = document.getElementById(id);
    e.currentTarget.appendChild(card);
  }

  function save() {
    const data = {};
    document.querySelectorAll('[data-tier]').forEach(el => {
      data[el.dataset.tier] = [...el.children].map(c => c.id);
    });
    localStorage.setItem('tierlist', JSON.stringify(data));
    alert('저장 완료! 💾');
  }

  function load() {
    const data = JSON.parse(localStorage.getItem('tierlist'));
    if (!data) {
      movies.forEach(m => document.getElementById('pool').appendChild(createCard(m)));
      return;
    }
    movies.forEach(m => {
      const card = createCard(m);
      let placed = false;
      for (const tier in data) {
        if (data[tier].includes('movie-' + m.id)) {
          document.querySelector(`[data-tier="${tier}"]`).appendChild(card);
          placed = true;
          break;
        }
      }
      if (!placed) document.getElementById('pool').appendChild(card);
    });
  }

