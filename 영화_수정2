<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>영화 티어리스트 🎬</title>
<style>
  body {
    font-family: 'Malgun Gothic', 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
    background: linear-gradient(135deg, #2d5016 0%, #4a7c2e 100%);
    margin: 0;
    padding: 20px;
    min-height: 100vh;
  }
  h1 {
    color: white;
    text-align: center;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  }
  .tier-row {
    display: flex;
    margin-bottom: 10px;
    background: rgba(255,255,255,0.1);
    border-radius: 8px;
    min-height: 100px;
    overflow: hidden;
  }
  .tier-label {
    width: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    font-weight: bold;
    color: white;
  }
  .tier-S { background: #FFD700; color: #333; }
  .tier-A { background: #FF8C42; }
  .tier-B { background: #87CEEB; color: #333; }
  .tier-C { background: #999; }
  .tier-content {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    padding: 10px;
    gap: 10px;
    min-height: 80px;
  }
  .pool-label {
    color: white;
    margin-top: 20px;
    margin-bottom: 10px;
    font-size: 18px;
  }
  .pool {
    background: rgba(0,0,0,0.3);
    border-radius: 8px;
    padding: 15px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    min-height: 100px;
  }
  .card {
    background: white;
    border-radius: 8px;
    padding: 10px;
    width: 80px;
    text-align: center;
    cursor: grab;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    transition: transform 0.2s;
  }
  .card:hover {
    transform: translateY(-3px);
  }
  .card:active {
    cursor: grabbing;
  }
  .card .emoji {
    font-size: 40px;
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
  }
  .card .title {
    font-size: 12px;
    margin-top: 5px;
    color: #333;
    font-weight: bold;
  }
  .buttons {
    text-align: center;
    margin-top: 20px;
  }
  button {
    padding: 10px 20px;
    margin: 0 5px;
    border: none;
    border-radius: 5px;
    background: white;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  }
  button:hover {
    background: #f0f0f0;
  }
</style>
</head>
<body>
  <h1>🎬 내 영화 티어리스트</h1>
  
  <div class="tier-row">
    <div class="tier-label tier-S">S</div>
    <div class="tier-content" data-tier="S" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
  </div>
  <div class="tier-row">
    <div class="tier-label tier-A">A</div>
    <div class="tier-content" data-tier="A" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
  </div>
  <div class="tier-row">
    <div class="tier-label tier-B">B</div>
    <div class="tier-content" data-tier="B" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
  </div>
  <div class="tier-row">
    <div class="tier-label tier-C">C</div>
    <div class="tier-content" data-tier="C" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
  </div>

  <div class="pool-label">📦 후보 영화 (드래그해서 티어에 배치하세요!)</div>
  <div class="pool" id="pool" data-tier="pool" ondrop="drop(event)" ondragover="allowDrop(event)"></div>

  <div class="buttons">
    <button onclick="save()">💾 저장</button>
    <button onclick="reset()">🔄 초기화</button>
  </div>

<script>
  const movies = [
    { id: 1,  title: "어바웃타임",   emoji: "⏰" },
    { id: 2,  title: "인터스텔라",   emoji: "🚀" },
    { id: 3,  title: "라라랜드",     emoji: "🎹" },
    { id: 4,  title: "기생충",       emoji: "🏠" },
    { id: 5,  title: "코코",         emoji: "💀" },
    { id: 6,  title: "노트북",       emoji: "📓" },
    { id: 7,  title: "해리포터",     emoji: "⚡" },
    { id: 8,  title: "타이타닉",     emoji: "🚢" },
    { id: 9,  title: "조커",         emoji: "🃏" },
    { id: 10, title: "토이스토리",   emoji: "🤠" }
  ];

  function createCard(movie) {
    const card = document.createElement('div');
    card.className = 'card';
    card.draggable = true;
    card.id = 'movie-' + movie.id;
    card.innerHTML = `
      <div class="emoji">${movie.emoji}</div>
      <div class="title">${movie.title}</div>
    `;
    card.ondragstart = (e) => e.dataTransfer.setData('text', card.id);
    return card;
  }

  function allowDrop(e) {
    e.preventDefault();
  }

  function drop(e) {
    e.preventDefault();
    const id = e.dataTransfer.getData('text');
    const card = document.getElementById(id);
    e.currentTarget.appendChild(card);
  }

  function save() {
    const data = {};
    document.querySelectorAll('[data-tier]').forEach(el => {
      data[el.dataset.tier] = [...el.children].map(c => c.id);
    });
    localStorage.setItem('tierlist', JSON.stringify(data));
    alert('저장 완료! 💾');
  }

  function load() {
    const data = JSON.parse(localStorage.getItem('tierlist'));
    if (!data) {
      movies.forEach(m => document.getElementById('pool').appendChild(createCard(m)));
      return;
    }
    movies.forEach(m => {
      const card = createCard(m);
      let placed = false;
      for (const tier in data) {
        if (data[tier].includes('movie-' + m.id)) {
          document.querySelector(`[data-tier="${tier}"]`).appendChild(card);
          placed = true;
          break;
        }
      }
      if (!placed) document.getElementById('pool').appendChild(card);
    });
  }

  function reset() {
    if (confirm('정말 초기화하시겠어요? 저장된 내용이 모두 사라져요!')) {
      localStorage.removeItem('tierlist');
      location.reload();
    }
  }

  load();
</script>
</body>
</html>
